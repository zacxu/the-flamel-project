&CONTROL
 calculation='vc-relax', prefix='p3_ref_mgo_90_k035_cont1', pseudo_dir='./pseudo', outdir='./scratch',
 tprnfor=.true., tstress=.true., verbosity='high',
 max_seconds=300, nstep=80, etot_conv_thr=1.0d-5, forc_conv_thr=8.0d-4,
/
&SYSTEM
 ibrav=0, nat=2, ntyp=2,
 ecutwfc=90.00000000, ecutrho=720.00000000, input_dft='PBE',
 nosym=.true., noinv=.true.,
 nspin=1, occupations='fixed',
/
&ELECTRONS
