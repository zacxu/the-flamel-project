&CONTROL
 calculation='relax', prefix='o2_box_15', pseudo_dir='./pseudo', outdir='./scratch',
 tprnfor=.true., tstress=.true., verbosity='high',
 max_seconds=1200, nstep=80, etot_conv_thr=1.0d-5, forc_conv_thr=8.0d-4,
/
&SYSTEM
 ibrav=0, nat=2, ntyp=1,
 ecutwfc=50.00000000, ecutrho=400.00000000, input_dft='PBE',
 nosym=.true., noinv=.true.,
 nspin=2, occupations='fixed',
 tot_magnetization=2, nbnd=8,
/
&ELECTRONS
 conv_thr=1.0d-8, electron_maxstep=100, scf_must_converge=.true., mixing_beta=0.4,
/
&IONS
 ion_dynamics='bfgs',
/
ATOMIC_SPECIES
O 15.99940000 O.pbe-n-kjpaw_psl.0.1.UPF
CELL_PARAMETERS angstrom
15.000000000000 0.000000000000 0.000000000000
0.000000000000 15.000000000000 0.000000000000
0.000000000000 0.000000000000 15.000000000000
ATOMIC_POSITIONS crystal
O 0.500000000000 0.500000000000 0.459000000000
O 0.500000000000 0.500000000000 0.541000000000
K_POINTS gamma
