&CONTROL
 calculation='vc-relax', prefix='mp_1096803', pseudo_dir='./pseudo', outdir='./scratch',
 tprnfor=.true., tstress=.true., verbosity='high',
 max_seconds=900, nstep=80, etot_conv_thr=1.0d-5, forc_conv_thr=8.0d-4,
/
&SYSTEM
 ibrav=0, nat=3, ntyp=2,
 ecutwfc=50.00000000, ecutrho=400.00000000, input_dft='PBE',
 nosym=.true., noinv=.true.,
 nspin=1, occupations='fixed',
/
&ELECTRONS
 conv_thr=1.0d-8, electron_maxstep=100, scf_must_converge=.true., mixing_beta=0.4,
/
&IONS
 ion_dynamics='bfgs',
/
&CELL
 cell_dynamics='bfgs', press=0.0, press_conv_thr=0.5, cell_dofree='all',
/
ATOMIC_SPECIES
Mg 24.30500000 Mg.pbe-n-kjpaw_psl.0.3.0.UPF
O 15.99940000 O.pbe-n-kjpaw_psl.0.1.UPF
CELL_PARAMETERS angstrom
1.546620000000 3.058608000000 0.000000000000
-1.546620000000 3.058608000000 0.000000000000
0.000000000000 0.338544000000 3.920821000000
ATOMIC_POSITIONS crystal
Mg 0.000000000000 0.000000000000 0.000000000000
O 0.313116000000 0.313116000000 0.795054000000
O 0.686884000000 0.686884000000 0.204946000000
K_POINTS automatic
4 4 3 0 0 0
